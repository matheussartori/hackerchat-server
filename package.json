{
  "name": "hackerchat-server",
  "version": "1.0.0",
  "description": "Chat service built using websockets, designed to accommodate clients connecting from various client types.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "chat",
    "shell",
    "terminal",
    "mesages",
    "websocket"
  ],
  "author": "Matheus Sartori",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.4.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
